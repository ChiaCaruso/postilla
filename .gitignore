public/pdfjs/

# ─── Test ─────────────────────────────────────────────────────
test-results/
e2e-report/
playwright-report/
blob-report/
playwright/.cache/
# PDF scaricati durante le prove a mano
samples/out/

# ─── Ambiente e segreti (l'app oggi non ne usa, ma non devono finire qui) ──
.env
.env.*
!.env.example
*.local

# ─── Log ──────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Cache ────────────────────────────────────────────────────
.cache/
.eslintcache

# ─── Python (scripts/brand-assets.py) ─────────────────────────
__pycache__/
*.pyc
.venv/

# ─── Editor e sistema operativo ───────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.sw?
.DS_Store
Thumbs.db

# ─── Strumenti locali (automazione del browser, assistente) ───
